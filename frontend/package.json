{
  "name": "videos-remotion",
  "version": "2.0.0",
  "description": "Remotion-based animated video generator with Voicebox TTS",
  "main": "src/index.ts",
  "scripts": {
    "start": "remotion studio src/index.ts",
    "build": "remotion render src/index.ts DynamicVideo out/output.mp4 --overwrite",
    "build:final": "cd ../backend && ./run.sh pipeline",
    "clean": "cd ../backend && ./run.sh clean"
  },
  "keywords": [
    "remotion",
    "animation",
    "video",
    "tts"
  ],
  "license": "ISC",
  "dependencies": {
    "@remotion/google-fonts": "^4.0.467",
    "@remotion/noise": "^4.0.467",
    "@remotion/transitions": "^4.0.467",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.466"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.466",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.5.0"
  }
}
